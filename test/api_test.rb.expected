-- support
true
[:escape, :prune, :whitewash, :strip, :nofollow, :noopener, :noreferrer, :targetblank, :newline_block_elements, :unprintable, :double_breakpoint]
-- a block scrubber
:top_down
<p>a<b>b</b></p>
["p", "text", "script", "text", "b", "text"]
-- a bottom-up block scrubber
["text", "i", "p", "text", "span", "div"]
-- STOP ends the descent
["div", "p", "span", "b", "text"]
-- a subclass scrubber
<p>HELLO <b>WORLD</b></p>
<a href="/x" rel="me external nofollow">x</a><a href="/y" rel="external nofollow">y</a>
-- scrubbers chain
<a href="http://x/" rel="nofollow noopener" target="_blank">x</a>
-- Node and NodeSet scrub!
<p>one</p><p>two<script>2</script></p>
<p>one</p><p>two&lt;script&gt;2&lt;/script&gt;</p>
